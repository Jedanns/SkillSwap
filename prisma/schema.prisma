// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma 7 uses the `prisma-client` generator. The client is emitted to the
// `output` path below and imported from there (see src/lib/prisma.ts).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL is configured in prisma.config.ts (for the CLI) and via
// the driver adapter at runtime (see src/lib/prisma.ts), so it is intentionally
// omitted here in Prisma 7.
datasource db {
  provider = "postgresql"
}

// =====================================================================
// PeerLearn (SkillSwap DSP F2I) — full data model.
// Conventions: UUID PKs, camelCase fields mapped to snake_case columns,
// snake_case table names via @@map. New rows generate their UUID in the
// database; Profile.id stays equal to the Supabase auth.users id.
// =====================================================================

// ----------------------------- Enums --------------------------------

enum SkillTier {
  HOLDER
  EXPERT
  MASTER
}

enum SkillStatus {
  ACTIVE
  PENDING_EVALUATION
}

enum AcquisitionSource {
  SELF_ATTRIBUTED
  EVALUATION
}

enum PingStatus {
  OPEN
  MATCHED
  RESOLVED
  CANCELLED
}

enum SessionKind {
  TUTORING
  EVALUATION
}

enum SessionStatus {
  PROPOSED
  CONFIRMED
  IN_PROGRESS
  AWAITING_FEEDBACK
  COMPLETED
  CANCELLED
}

enum ParticipationStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ReviewDirection {
  STUDENT_TO_TUTOR
  TUTOR_TO_STUDENT
}

enum ScoringScale {
  OUT_OF_10
  OUT_OF_20
}

enum ConversationType {
  DIRECT
  GROUP
  SESSION
}

enum PostKind {
  GENERAL
  TUTORING_OFFER
  ANNOUNCEMENT
}

enum LevelTrack {
  ACCOUNT
  TUTOR
  STUDENT
  SKILL
}

enum ActivityType {
  POST_CREATED
  COMMENT_CREATED
  MESSAGE_SENT
  SESSION_TAUGHT
  SESSION_ATTENDED
  SKILL_ATTRIBUTED
  FEEDBACK_GIVEN
  PING_CREATED
  LIKE_GIVEN
}

enum NotificationType {
  PING_RECEIVED
  MESSAGE_RECEIVED
  SESSION_PROPOSED
  SESSION_APPROVED
  SESSION_DECLINED
  SESSION_CANCELLED
  SESSION_COMPLETED
  FEEDBACK_REQUEST
  EVALUATION_RESULT
  POST_LIKED
  POST_COMMENTED
  SKILL_CERTIFIED
  LEVEL_UP
}

// ----------------------- Identity & gamification --------------------

/// Application profile, mirrored 1:1 from Supabase `auth.users`.
/// `id` equals the Supabase auth user id (UUID) and is kept in sync by the
/// `on_auth_user_created` trigger (see the RLS/trigger SQL migration).
model Profile {
  id       String  @id @db.Uuid
  email    String  @unique
  username String? @unique

  firstName   String? @map("first_name")
  lastName    String? @map("last_name")
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")
  bio         String?
  headline    String?
  cohort      String?
  githubUrl   String? @map("github_url")
  linkedinUrl String? @map("linkedin_url")

  // Onboarding — drives the forced redirect to profile completion (Volet 2).
  isProfileComplete Boolean   @default(false) @map("is_profile_complete")
  onboardedAt       DateTime? @map("onboarded_at")

  // Gamification — three axes (raw ints; tiers computed against LevelThreshold).
  accountLevel Int @default(1) @map("account_level")
  accountXp    Int @default(0) @map("account_xp")
  tutorLevel   Int @default(1) @map("tutor_level")
  tutorXp      Int @default(0) @map("tutor_xp")
  studentLevel Int @default(1) @map("student_level")
  studentXp    Int @default(0) @map("student_xp")

  // Cached aggregates for ranking / UI.
  tutorRatingAvg   Decimal? @map("tutor_rating_avg") @db.Decimal(3, 2)
  studentRatingAvg Decimal? @map("student_rating_avg") @db.Decimal(3, 2)
  sessionsTaught   Int      @default(0) @map("sessions_taught")
  sessionsAttended Int      @default(0) @map("sessions_attended")

  featuredOnLanding Boolean @default(false) @map("featured_on_landing")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  skills             UserSkill[]
  pings              SkillPing[]
  rubrics            Rubric[]
  sessionsAsTutor    TutoringSession[]
  participations     SessionParticipant[]
  reviewsGiven       Review[]                  @relation("ReviewReviewer")
  reviewsReceived    Review[]                  @relation("ReviewReviewee")
  conversations      ConversationParticipant[]
  messages           Message[]
  posts              Post[]
  comments           Comment[]
  likes              PostLike[]
  notifications      Notification[]            @relation("NotificationRecipient")
  notificationsActed Notification[]            @relation("NotificationActor")
  activity           ActivityEvent[]
  skillsAuthored     Skill[]                   @relation("SkillCreatedBy")
  skillsCertified    Skill[]                   @relation("SkillCertifiedBy")

  @@map("profiles")
}

/// Gamification config — XP thresholds per track/level, editable without a
/// migration so the balancing phase can tune the curves. The spec's
/// Expert=Lvl3 / Master=Lvl5 are represented as SKILL rows with a tierLabel.
model LevelThreshold {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  track     LevelTrack
  level     Int
  minXp     Int        @map("min_xp")
  tierLabel String?    @map("tier_label")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([track, level])
  @@map("level_thresholds")
}

/// Account-XP ledger — every meaningful action on the platform grants XP.
model ActivityEvent {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String       @map("profile_id") @db.Uuid
  type      ActivityType
  xpAwarded Int          @default(0) @map("xp_awarded")
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("activity_events")
}

// --------------------------- Skills catalogue -----------------------

model SkillCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  skills Skill[]

  @@map("skill_categories")
}

/// The global / canonical competence.
model Skill {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String  @unique
  canonicalDescription String? @map("canonical_description")
  categoryId           String? @map("category_id") @db.Uuid
  createdById          String  @map("created_by_id") @db.Uuid

  // Certification (Volet 6). Once certified the skill can no longer be
  // self-attributed (guarded in the app layer + RLS).
  isCertified   Boolean   @default(false) @map("is_certified")
  certifiedAt   DateTime? @map("certified_at")
  certifiedById String?   @map("certified_by_id") @db.Uuid

  // Denormalized pointer to the UserSkill whose custom presentation is shown
  // on the public skill page (the highest-combined-level holder). Recomputed
  // on level changes.
  featuredUserSkillId String? @unique @map("featured_user_skill_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category          SkillCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy         Profile           @relation("SkillCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  certifiedBy       Profile?          @relation("SkillCertifiedBy", fields: [certifiedById], references: [id], onDelete: SetNull)
  featuredUserSkill UserSkill?        @relation("SkillFeaturedUserSkill", fields: [featuredUserSkillId], references: [id], onDelete: SetNull)
  holders           UserSkill[]       @relation("SkillHolders")
  pings             SkillPing[]
  rubrics           Rubric[]
  sessions          TutoringSession[]
  posts             Post[]

  @@index([categoryId])
  @@index([createdById])
  @@index([isCertified])
  @@map("skills")
}

/// A student's possession of a skill: attribution + per-student custom
/// presentation (the "version" folded in) + per-skill progression.
model UserSkill {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  skillId   String @map("skill_id") @db.Uuid

  // Progression
  level    Int       @default(1)
  xp       Int       @default(0)
  tier     SkillTier @default(HOLDER)
  canTeach Boolean   @default(false) @map("can_teach")

  // Provenance
  status     SkillStatus       @default(ACTIVE)
  source     AcquisitionSource @default(SELF_ATTRIBUTED)
  acquiredAt DateTime          @default(now()) @map("acquired_at")

  // Custom presentation (the per-student version of the skill).
  customTitle       String? @map("custom_title")
  customDescription String? @map("custom_description")
  customImageUrl    String? @map("custom_image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill       Skill   @relation("SkillHolders", fields: [skillId], references: [id], onDelete: Cascade)
  featuredFor Skill?  @relation("SkillFeaturedUserSkill")

  @@unique([profileId, skillId])
  @@index([skillId, level])
  @@index([profileId])
  @@map("user_skills")
}

/// A student publicly signals they want a tutor on a skill (Volet 3).
model SkillPing {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String     @map("requester_id") @db.Uuid
  skillId     String     @map("skill_id") @db.Uuid
  message     String?
  status      PingStatus @default(OPEN)
  createdAt   DateTime   @default(now()) @map("created_at")
  resolvedAt  DateTime?  @map("resolved_at")

  requester Profile @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, status])
  @@index([requesterId])
  @@map("skill_pings")
}

// ----------------------- Certification / evaluation -----------------

/// An expert's evaluation referential for a certified skill (Volet 6).
model Rubric {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId      String       @map("skill_id") @db.Uuid
  expertId     String       @map("expert_id") @db.Uuid
  scale        ScoringScale @default(OUT_OF_20)
  passingScore Int          @map("passing_score")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  skill    Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  expert   Profile           @relation(fields: [expertId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]
  sessions TutoringSession[]
  reviews  Review[]

  @@unique([skillId, expertId])
  @@index([skillId])
  @@map("rubrics")
}

/// A single notion / checkbox within a rubric.
model RubricCriterion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rubricId String @map("rubric_id") @db.Uuid
  label    String
  position Int    @default(0)

  rubric      Rubric             @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  validations NotionValidation[]

  @@index([rubricId])
  @@map("rubric_criteria")
}

// ------------------------------ Tutoring ----------------------------

model TutoringSession {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutorId         String        @map("tutor_id") @db.Uuid
  skillId         String        @map("skill_id") @db.Uuid
  conversationId  String?       @map("conversation_id") @db.Uuid
  kind            SessionKind   @default(TUTORING)
  title           String
  description     String?
  scheduledAt     DateTime      @map("scheduled_at")
  durationMinutes Int           @map("duration_minutes")
  status          SessionStatus @default(PROPOSED)
  isPublic        Boolean       @default(false) @map("is_public")
  rubricId        String?       @map("rubric_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  tutor        Profile              @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  skill        Skill                @relation(fields: [skillId], references: [id], onDelete: Restrict)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  rubric       Rubric?              @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  participants SessionParticipant[]
  reviews      Review[]

  @@index([tutorId, scheduledAt])
  @@index([skillId])
  @@index([status, scheduledAt])
  @@map("tutoring_sessions")
}

/// One student per row; public sessions hold many — each approves individually.
model SessionParticipant {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String              @map("session_id") @db.Uuid
  studentId String              @map("student_id") @db.Uuid
  status    ParticipationStatus @default(PENDING)
  attended  Boolean             @default(false)
  createdAt DateTime            @default(now()) @map("created_at")

  session TutoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Profile         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@map("session_participants")
}

// ------------------------------ Feedback ----------------------------

/// Post-session feedback, both directions (Volets 3 & 4). Evaluation extras
/// (score/passed/rubric) apply only to tutor->student reviews on EVALUATION
/// sessions for certified skills.
model Review {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String          @map("session_id") @db.Uuid
  reviewerId String          @map("reviewer_id") @db.Uuid
  revieweeId String          @map("reviewee_id") @db.Uuid
  direction  ReviewDirection
  rating     Int
  comment    String?

  score    Int?
  passed   Boolean?
  rubricId String?  @map("rubric_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  session  TutoringSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer Profile            @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee Profile            @relation("ReviewReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  rubric   Rubric?            @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  notions  NotionValidation[]

  @@unique([sessionId, reviewerId, revieweeId])
  @@index([revieweeId])
  @@index([sessionId])
  @@map("reviews")
}

/// Tutor's per-notion acquisition checkboxes (Volets 4 & 6). Linked to a
/// rubric criterion for certified skills, or a free-text label otherwise.
model NotionValidation {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId          String  @map("review_id") @db.Uuid
  rubricCriterionId String? @map("rubric_criterion_id") @db.Uuid
  label             String?
  acquired          Boolean @default(false)

  review          Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  rubricCriterion RubricCriterion? @relation(fields: [rubricCriterionId], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@map("notion_validations")
}

// -------------------------------- Chat ------------------------------

model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ConversationType @default(DIRECT)
  sessionId     String?          @unique @map("session_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  lastMessageAt DateTime?        @map("last_message_at")

  participants ConversationParticipant[]
  messages     Message[]
  sessions     TutoringSession[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  profileId      String    @map("profile_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([conversationId, profileId])
  @@index([profileId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ----------------------------- Social feed --------------------------

model Post {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  kind         PostKind @default(GENERAL)
  content      String
  skillId      String?  @map("skill_id") @db.Uuid
  likeCount    Int      @default(0) @map("like_count")
  commentCount Int      @default(0) @map("comment_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  author   Profile    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  skill    Skill?     @relation(fields: [skillId], references: [id], onDelete: SetNull)
  likes    PostLike[]
  comments Comment[]

  @@index([authorId, createdAt])
  @@index([skillId])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([profileId])
  @@map("post_likes")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

// ----------------------------- Cross-cutting ------------------------

/// Polymorphic notification (entityType/entityId point at the target).
model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  actorId     String?          @map("actor_id") @db.Uuid
  entityType  String?          @map("entity_type")
  entityId    String?          @map("entity_id") @db.Uuid
  data        Json?
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient Profile  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     Profile? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}
