// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma 7 uses the `prisma-client` generator. The client is emitted to the
// `output` path below and imported from there (see src/lib/prisma.ts).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL is configured in prisma.config.ts (for the CLI) and via
// the driver adapter at runtime (see src/lib/prisma.ts), so it is intentionally
// omitted here in Prisma 7.
datasource db {
  provider = "postgresql"
}

/// Application profile, mirrored 1:1 from Supabase `auth.users`.
/// `id` should equal the Supabase auth user id (UUID). Keep it in sync from
/// your auth flow — e.g. a Postgres trigger on `auth.users`, or an upsert
/// right after sign-up. This is just a starter model; adapt it to SkillSwap.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  username  String?  @unique
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}
