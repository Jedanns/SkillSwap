# =============================================================================
# .env.example — COMMIT THIS FILE. It documents every variable the app needs.
# Never put real secrets here. To set up locally:
#
#   cp .env.example .env   # then fill in the values below
#
# .env is read by BOTH Next.js and Prisma. Both .env and .env*.local are
# gitignored; only this template is tracked.
# =============================================================================

# --- Supabase (read by Next.js) -------------------------------------------------

# Your project's API endpoint. Safe to expose (it's public).
# Dashboard: Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Publishable key (new key format, replaces the legacy `anon` key). Safe in the
# browser — access is governed by Row Level Security. Format: sb_publishable_...
# Dashboard: Project Settings > API Keys > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# Secret key (new format, replaces legacy `service_role`). SERVER-ONLY: use only
# in Route Handlers / Server Actions / Server Components. NEVER prefix with
# NEXT_PUBLIC_ — that would leak full-access credentials into the JS bundle.
# Dashboard: Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"

# --- Database (read by Prisma) --------------------------------------------------
# Get both strings from the Supabase dashboard: "Connect" button > ORMs / Prisma.
# Replace YOUR-PROJECT-REF, YOUR-DB-PASSWORD and YOUR-REGION with your values.

# Pooled connection (Supavisor transaction mode, port 6543) — used by Prisma
# Client at runtime. Keep ?pgbouncer=true (transaction pooling has no prepared
# statements). For serverless/edge, also append &connection_limit=1.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by the Prisma CLI for `migrate` / `db pull`.
# Migrations must NOT go through the pooler.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"
